# Database — Neon is the single canonical persistent database
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Primary search APIs
KEENABLE_API_KEY=        # https://keenable.ai — primary web search/content
TINYFISH_API_KEY=        # https://tinyfish.ai — primary web search + page fetch

# Search fallback
EXA_API_KEY=             # https://exa.ai — fallback only when primary coverage is low

# Page extraction / adjudication
TAVILY_API_KEY=          # https://tavily.com — page extraction
FIRECRAWL_API_KEY=       # https://firecrawl.dev — JS-rendered pages
GROQ_API_KEY=            # https://console.groq.com — LLM extraction (free tier)
OPENROUTER_KEY=          # https://openrouter.ai — alternative LLM (optional)

# Optional enrichment
BROWSE_AI_API_KEY=       # https://browse.ai
JINA_API_KEY=            # https://jina.ai

# App config
NODE_ENV=production
PORT=3000
